# Copy to .env.local (git-ignored) and fill in. Never commit real values.
#
# Everything named EXPO_PUBLIC_* is compiled INTO the app and can be extracted by anyone who has it.
# It is configuration, not a secret vault. The MSG91 *account Authkey* must never appear here:
# it belongs to the backend only (MSG91_AUTHKEY in KaamConnectBackendAPI/.env).

# The backend origin (no path). Android emulator: http://10.0.2.2:3000, a real phone: your PC's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:3000

# MSG91 OTP widget (dashboard > OTP > your widget). Leave both empty to keep using the backend's own OTP flow
# (the development code); MSG91 is also never used on the web. Use a separate widget per environment
# (development / staging / production) and set that environment's values in its EAS build profile.
EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_TOKEN_AUTH=

# Google Maps Platform key for the location picker (Places search, geocoding, native map). Enable on the key:
# Maps SDK for Android, Maps SDK for iOS, Places API (New), Geocoding API. Restrict it to the app (Android package +
# SHA-1, iOS bundle id). It is read when the app is built (app.config.js) and bundled, so rebuild the dev client
# after changing it. Leave empty to hide map search; the manual sector chooser keeps working.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
