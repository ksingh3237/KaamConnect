{
  "expo": {
    "name": "KaamConnect",
    "slug": "kaamconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kaamconnect",
    "splash": {
      "backgroundColor": "#00B074"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaamconnect.app"
    },
    "android": {
      "package": "com.kaamconnect.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "374b43a4-46ee-45c6-87ec-380aa3df941f"
      }
    }
  }
}
