{
  "expo": {
    "name": "KaamConnect",
    "slug": "kaamconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "kaamconnect",
    "splash": {
      "backgroundColor": "#00B074"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaamconnect.app"
    },
    "android": {
      "package": "com.kaamconnect.app",
      "permissions": [
        "CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "KaamConnect needs your photos so you can attach pictures to jobs and your profile.",
          "cameraPermission": "KaamConnect needs the camera so you can take photos of the job and your documents."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00B074",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "374b43a4-46ee-45c6-87ec-380aa3df941f"
      }
    }
  }
}
